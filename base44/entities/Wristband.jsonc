{
  "name": "Wristband",
  "type": "object",
  "properties": {
    "nfc_id": {
      "type": "string",
      "description": "Serial number of the NFC tag"
    },
    "order_number": {
      "type": "string",
      "description": "Linked order number"
    },
    "customer_name": {
      "type": "string",
      "description": "Name of the wristband owner"
    },
    "allowed_events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of allowed events/parties"
    },
    "cancelled_events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Events that were cancelled due to refunds"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Wristband status"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Expiration date (departure date)"
    }
  },
  "required": [
    "nfc_id",
    "order_number"
  ]
}