{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "done"
      ],
      "default": "todo",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d9\u05e2\u05d3"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "general",
        "refund",
        "supplier_payment",
        "add_event",
        "expense_receipt"
      ],
      "default": "general",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "refund_type": {
      "type": "string",
      "enum": [
        "full",
        "partial"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d4\u05d7\u05d6\u05e8"
    },
    "amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05d4\u05d7\u05d6\u05e8/\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "currency": {
      "type": "string",
      "default": "EUR",
      "description": "\u05de\u05d8\u05d1\u05e2"
    },
    "order_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "people_count": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05d0\u05e0\u05e9\u05d9\u05dd (\u05dc\u05d4\u05d7\u05d6\u05e8 \u05d0\u05d5 \u05dc\u05ea\u05e9\u05dc\u05d5\u05dd)"
    },
    "scanned_count": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05e0\u05e1\u05e8\u05e7\u05d9\u05dd \u05d1\u05e4\u05d5\u05e2\u05dc"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "event_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "departure_date": {
      "type": "string",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e2\u05d6\u05d9\u05d1\u05d4"
    },
    "related_events": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05dc\u05d1\u05d9\u05d8\u05d5\u05dc/\u05d4\u05d7\u05d6\u05e8/\u05d4\u05d5\u05e1\u05e4\u05d4"
    },
    "related_wristbands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05de\u05d6\u05d4\u05d9 \u05e6\u05de\u05d9\u05d3\u05d9\u05dd (NFC) \u05e2\u05d1\u05d5\u05e8\u05dd \u05de\u05d1\u05d5\u05e7\u05e9 \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9"
    },
    "sales_rep": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e0\u05e6\u05d9\u05d2"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05de\u05e9\u05d9\u05de\u05d4 \u05e7\u05d1\u05d5\u05e2\u05d4"
    },
    "recurring_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "\u05d9\u05de\u05d9\u05dd \u05e7\u05d1\u05d5\u05e2\u05d9\u05dd 0-6"
    },
    "last_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d1\u05d9\u05e6\u05d5\u05e2 \u05d0\u05d7\u05e8\u05d5\u05df \u05dc\u05de\u05e9\u05d9\u05de\u05d4 \u05e7\u05d1\u05d5\u05e2\u05d4"
    },
    "notification_sent": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05e9\u05dc\u05d7\u05d4 \u05d4\u05ea\u05e8\u05d0\u05d4"
    },
    "receipt_file_url": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d4-URL \u05e9\u05dc \u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05e7\u05d1\u05dc\u05d4"
    },
    "expense_category": {
      "type": "string",
      "enum": [
        "\u05d9\u05e6\u05d0 \u05de\u05d4\u05d9\u05e2\u05d3",
        "\u05d4\u05d7\u05d6\u05e8 \u05de\u05dc\u05d0",
        "\u05d4\u05d7\u05d6\u05e8 \u05d7\u05dc\u05e7\u05d9",
        "\u05e8\u05db\u05d1",
        "\u05d0\u05d7\u05e8",
        "\u05de\u05e9\u05d9\u05db\u05d4 \u05dc\u05d0\u05d3\u05dd",
        "\u05ea\u05e9\u05dc\u05d5\u05dd \u05dc\u05e1\u05e4\u05e7",
        "\u05e4\u05d9\u05e6\u05d5\u05d9 \u05e7\u05e9\u05e8\u05d9 \u05ea\u05e2\u05d5\u05e4\u05d4",
        "\u05e4\u05d9\u05e6\u05d5\u05d9 \u05e0\u05d8\u05d5 \u05e4\u05d0\u05df",
        "\u05e4\u05d9\u05e0\u05d5\u05e7 \u05dc\u05dc\u05e7\u05d5\u05d7\u05d5\u05ea",
        "\u05e4\u05d9\u05e0\u05d5\u05e7 \u05dc\u05e0\u05e6\u05d9\u05d2\u05d9\u05dd",
        "\u05d0\u05e9\u05dc",
        "\u05d3\u05dc\u05e7"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05e7\u05d1\u05dc\u05d4"
    },
    "expense_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05e7\u05d1\u05dc\u05d4"
    },
    "expense_currency": {
      "type": "string",
      "enum": [
        "ILS",
        "USD",
        "EUR"
      ],
      "description": "\u05de\u05d8\u05d1\u05e2 \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05e7\u05d1\u05dc\u05d4"
    },
    "actual_expense_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05d1\u05e4\u05d5\u05e2\u05dc"
    }
  },
  "required": [
    "title"
  ]
}