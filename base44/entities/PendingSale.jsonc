    },
    "shekel_amount": {
      "type": "string",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d1\u05e9\u05e7\u05dc\u05d9\u05dd"
    },
    "dollar_amount": {
      "type": "string",
