      "type": "string",
      "description": "\u05d7\u05d1\u05e8\u05d4"
    },
    "requested_amount": {
      "type": "string",
      "description": "\u05e1\u05db\u05d5\u05dd \u05de\u05d1\u05d5\u05e7\u05e9"
    },
    "eur_amount": {
      "type": "string",
